+    # Windows arrow keys arrive as a \x00/\xe0 prefix + scancode letter
+    _ARROWS_WIN = {"H": "up", "P": "down", "M": "right", "K": "left"}
+
+    def _reader_windows(self):
+        while not self._stop.is_set():
+            if not msvcrt.kbhit():
+                time.sleep(0.05)
+                continue
+            ch = msvcrt.getwch()
+            if ch in ("\x00", "\xe0"):
+                name = self._ARROWS_WIN.get(msvcrt.getwch())
+                if name:
+                    self._queue.put(name)
+                continue
+            self._queue.put(ch.lower() if ch.isalpha() else ch)
